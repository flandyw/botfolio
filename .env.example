# Alpaca PAPER trading keys (https://app.alpaca.markets/paper/dashboard/overview -> API Keys).
# Paper keys start with "PK". Live keys will not work: every trading call is hard-wired to the
# paper endpoint and the account must be a paper account (number starts with "PA").
ALPACA_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (APCA_API_KEY_ID / APCA_API_SECRET_KEY are accepted too)

# Optional
BOTFOLIO_DB_PATH=data/botfolio.sqlite
BOTFOLIO_LOG_LEVEL=INFO
BOTFOLIO_LOG_JSON=true
# BOTFOLIO_DATA_FEED=iex
# BOTFOLIO_SYMBOLS=QQQ,SPY
# Mirror ONE virtual portfolio's orders onto your Alpaca paper account (off by default):
# BOTFOLIO_MIRROR_STRATEGY=noise_mom_1m

# Event research: disabled AI abstains; no orders are sent by default.
EVENT_AI_PROVIDER=disabled
# chat = chat completions; systemone = Jev/Clef; clairic = Cloudflare typed fields
EVENT_AI_MODEL=disabled
EVENT_AI_URL=
EVENT_AI_KEY=
EVENT_AI_TIMEOUT=30
# New experiment for each deployed model or prompt change (systemd unit).
# EVENT_AI_EXPERIMENT=clairic-v1
# Optional documented input-token price; unknown costs remain null (not zero).
EVENT_AI_INPUT_USD_PER_MILLION=
# SEC requires a real organization/contact User-Agent. CIK mapping is explicit.
SEC_USER_AGENT=
SEC_COMPANIES={}
# Dedicated PAPER account only: never share it with technical PaperMirror or manual trades.
EVENT_PAPER_ENABLED=false
EVENT_EXCLUSIVE_ACCOUNT=false
EVENT_HOLD_MINUTES=15
EVENT_KILL_FILE=data/EVENT_KILL
# Set a strong password before sharing the dashboard through an internet tunnel.
BOTFOLIO_DASHBOARD_PASSWORD=
