# Alpaca Paper API credentials (https://app.alpaca.markets/paper/dashboard/overview -> API Keys).
# Paper keys start with "PK" and paper account numbers start with "PA".
# Live keys are rejected: every trading call is locked to the paper endpoint.
ALPACA_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# APCA_API_KEY_ID and APCA_API_SECRET_KEY are also supported.

# Optional runtime settings
BOTFOLIO_DB_PATH=data/botfolio.sqlite
BOTFOLIO_LOG_LEVEL=INFO
BOTFOLIO_LOG_JSON=true
# BOTFOLIO_DATA_FEED=iex
# BOTFOLIO_SYMBOLS=QQQ,SPY

# News AI analysis and paper execution start disabled by default.
EVENT_AI_PROVIDER=disabled
# Providers: chat = OpenAI-compatible chat completions; systemone = Jev/Clef; clairic = Cloudflare Workers AI
EVENT_AI_MODEL=disabled
EVENT_AI_URL=
EVENT_AI_KEY=
EVENT_AI_TIMEOUT=30
# Change the experiment ID whenever you update the provider, model, endpoint, or prompt.
# EVENT_AI_EXPERIMENT=clairic-v1

# Optional secondary AI analyst (for example, Vercel AI Gateway):
# EVENT_AI_SECONDARY_PROVIDER=chat
# EVENT_AI_SECONDARY_MODEL=meta/muse-ember
# EVENT_AI_SECONDARY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
# EVENT_AI_SECONDARY_KEY=
# EVENT_AI_SECONDARY_EXPERIMENT=muse-ember-v1
# "auto" paces EVENT_AI_MONTHLY_USD evenly across the month; a number (0-1) sets a fixed share within budget.
# EVENT_AI_SECONDARY_SHARE=auto
# EVENT_AI_MONTHLY_USD=1  # Vercel includes $5/month in free credit
# Max requests per minute to the secondary provider before overflowing to the primary provider.
# EVENT_AI_SECONDARY_RPM=10
# Optional input-token price (USD per million); unknown costs are stored as null rather than zero.
EVENT_AI_INPUT_USD_PER_MILLION=

# SEC EDGAR requires a contact User-Agent string; map tickers to CIKs explicitly in SEC_COMPANIES.
SEC_USER_AGENT=
SEC_COMPANIES={}

# Dedicated Alpaca Paper account only: do not share with manual trading or other bots.
EVENT_PAPER_ENABLED=false
EVENT_EXCLUSIVE_ACCOUNT=false
EVENT_HOLD_MINUTES=15
EVENT_KILL_FILE=data/EVENT_KILL

# Password protecting the Control and News pages. Set this before exposing the dashboard
# outside a trusted local or Tailscale network.
BOTFOLIO_DASHBOARD_PASSWORD=
