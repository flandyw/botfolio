# Alpaca Paper API credentials (https://app.alpaca.markets/paper/dashboard/overview -> API Keys).
# Paper keys start with "PK" and paper account numbers start with "PA".
# Live keys are rejected: every trading call is locked to the paper endpoint.
ALPACA_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# APCA_API_KEY_ID and APCA_API_SECRET_KEY are also supported.

# Optional runtime settings
BOTFOLIO_DB_PATH=data/botfolio.sqlite
BOTFOLIO_LOG_LEVEL=INFO
BOTFOLIO_LOG_JSON=true
# BOTFOLIO_DATA_FEED=iex
# BOTFOLIO_SYMBOLS=QQQ,SPY

# News AI analysis and paper execution start disabled by default.
EVENT_AI_PROVIDER=disabled
# Providers: chat = OpenAI-compatible chat completions; systemone = Jev/Clef; clairic = Cloudflare Workers AI
EVENT_AI_MODEL=disabled
EVENT_AI_URL=
EVENT_AI_KEY=
EVENT_AI_TIMEOUT=30
# Change the experiment ID whenever you update the provider, model or endpoint.
# EVENT_AI_EXPERIMENT=clairic-v1

# Further providers. Each is enabled by its _MODEL; the dashboard sets their priority order
# (default: claude, chatgpt, vercel, cloudflare) and model choices.
# Local Claude Code CLI on this machine's Claude plan (`claude -p`); EVENT_AI_CLAUDE_BIN overrides the path.
# EVENT_AI_CLAUDE_MODEL=sonnet
# EVENT_AI_CLAUDE_EXPERIMENT=claude-v1
# EVENT_AI_CLAUDE_5H_CALLS=100
# EVENT_AI_CLAUDE_WEEK_CALLS=1000
# ChatGPT plan via the sign-in sidecar (botfolio-chatgpt.service, web/server/chatgpt.ts).
# EVENT_AI_CHATGPT_MODEL=gpt-6.2-sol
# EVENT_AI_CHATGPT_URL=http://127.0.0.1:8611/respond
# EVENT_AI_CHATGPT_EXPERIMENT=chatgpt-v1
# EVENT_AI_CHATGPT_5H_CALLS=100
# EVENT_AI_CHATGPT_WEEK_CALLS=1000
# Vercel AI Gateway (or OpenRouter: any OpenAI-compatible chat completions URL).
# EVENT_AI_VERCEL_MODEL=meta/muse-ember
# EVENT_AI_VERCEL_URL=https://ai-gateway.vercel.sh/v1/chat/completions
# EVENT_AI_VERCEL_KEY=
# EVENT_AI_VERCEL_EXPERIMENT=muse-ember-v1
# EVENT_AI_MONTHLY_USD=1  # paced evenly across the month; Vercel includes $5/month in free credit
# EVENT_AI_VERCEL_RPM=10
# Optional input-token price (USD per million); unknown costs are stored as null rather than zero.
EVENT_AI_INPUT_USD_PER_MILLION=

# SEC EDGAR requires a contact User-Agent ("Name you@example.com"). Setting it turns on 8-K filings for the whole
# watchlist. SEC_COMPANIES ({"AAPL": "320193"}) is optional and also follows those companies' 10-Q and 10-K filings.
SEC_USER_AGENT=
SEC_COMPANIES={}

# Dedicated Alpaca Paper account only: do not share with manual trading or other bots.
EVENT_PAPER_ENABLED=false
EVENT_EXCLUSIVE_ACCOUNT=false
EVENT_HOLD_MINUTES=15
EVENT_KILL_FILE=data/EVENT_KILL

# Password protecting the Control and News pages. Set this before exposing the dashboard
# outside a trusted local or Tailscale network.
BOTFOLIO_DASHBOARD_PASSWORD=
