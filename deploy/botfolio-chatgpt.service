[Unit]
Description=Botfolio ChatGPT sidecar (Sign in with ChatGPT; loopback API for the news AI on 127.0.0.1:8611)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/botfolio/web
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.3/bin/node --experimental-strip-types server/chatgpt.ts serve
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
